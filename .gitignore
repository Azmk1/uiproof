# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# generated comparison artifacts (screenshots + reports)
/.uiproof/
/.logs/

# benchmark output: the newest report is committed evidence, stamped copies are local history
/docs/benchmark/*.json
!/docs/benchmark/latest.json

# the Phase 9 example applications are built inside the repair sandbox, never in the tree
/examples/vite-app/dist
/examples/vite-app/node_modules
/examples/next-app/.next
/examples/next-app/node_modules

# local project registrations (see examples/uiproof.config.example.json)
/uiproof.config.json

# local Freebuff workspace metadata
/.freebuff/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
