{
  "name": "uiproof",
  "version": "0.2.0-rc.1",
  "private": true,
  "description": "UIProof — automated frontend quality platform for visual regression detection.",
  "bin": {
    "uiproof": "./bin/uiproof.mjs"
  },
  "files": [
    "bin/",
    "dist/cli/",
    "docs/REPAIR-SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "benchmark": "vitest run --config vitest.benchmark.config.mts",
    "verify": "eslint && tsc --noEmit && vitest run && next build && vitest run --config vitest.e2e.config.mts",
    "setup:browser": "playwright install chromium",
    "example:app": "node examples/example-app/server.mjs",
    "uiproof": "node scripts/uiproof.mjs",
    "build:cli": "node scripts/uiproof.mjs --build-only",
    "prepack": "node scripts/uiproof.mjs --build-only --bundle-out dist/cli/uiproof.mjs",
    "pack:local": "pnpm pack"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.17.0"
}
